rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artworks/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /references/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rawWorks/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
